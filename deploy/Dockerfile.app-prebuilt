# 预编译 JAR 版后端镜像（服务器到 Docker Hub 不通时的离线构建路径）
# 前置：在 backend 目录编译出 JAR 并复制为仓库根目录 app.jar：
#   ./mvnw -DskipTests package
#   cp backend/target/polyauth-backend-1.0.0-SNAPSHOT.jar app.jar
#   docker build -f deploy/Dockerfile.app-prebuilt -t <registry>/iam-app:1.0.0 .

FROM swr.cn-north-4.myhuaweicloud.com/ooad-mytx/openjdk:21-alpine
WORKDIR /app
COPY deploy/entrypoint.sh /app/entrypoint.sh
COPY app.jar /app/app.jar
RUN sed -i 's/\r$//' /app/entrypoint.sh \
 && chmod 0755 /app/entrypoint.sh \
 && apk add --no-cache curl tzdata \
 && addgroup -S -g 10001 iam \
 && adduser -S -u 10001 -G iam iam \
 && mkdir -p /app/logs \
 && chown -R iam:iam /app
ENV APP_BACKEND_STRATEGY=structured
ENV LOG_PATH=/app/logs
USER 10001
EXPOSE 8080 8081
ENTRYPOINT ["/app/entrypoint.sh"]
