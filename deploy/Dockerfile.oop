# DDD 策略后端镜像（构建上下文 = PolyAuth 仓库根目录）
#   docker build -f deploy/Dockerfile.oop -t <registry>/iam-oop-app:1.0.1 .
# 与结构化镜像共用同一份 JAR，仅通过 APP_BACKEND_STRATEGY 切换 Service 实现。

FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /build
COPY backend/pom.xml ./pom.xml
COPY backend/lib-repo ./lib-repo
COPY backend/src ./src
RUN mvn -q -DskipTests package

FROM eclipse-temurin:17-jre
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl tzdata \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 iam \
 && mkdir -p /app/logs
COPY deploy/entrypoint.sh /app/entrypoint.sh
COPY --from=build /build/target/polyauth-backend-1.0.0-SNAPSHOT.jar /app/app.jar
RUN sed -i 's/\r$//' /app/entrypoint.sh \
 && chmod 0755 /app/entrypoint.sh \
 && chown -R iam:iam /app
ENV APP_BACKEND_STRATEGY=ddd
ENV LOG_PATH=/app/logs
USER 10001
EXPOSE 8080 8082
ENTRYPOINT ["/app/entrypoint.sh"]
