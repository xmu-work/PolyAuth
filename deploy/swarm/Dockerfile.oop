# OOP 后端镜像（构建上下文 = PolyAuth 仓库根目录）
#   docker build -f deploy/swarm/Dockerfile.oop -t <registry>/iam-oop-app:1.0.1 .
# 单元测试在 CI 或构建机单独执行；镜像构建只负责打包。

FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /build
COPY pom.xml .
COPY structured-backend/pom.xml ./structured-backend/pom.xml
COPY oop-backend/pom.xml ./oop-backend/pom.xml
COPY contract-tests/pom.xml ./contract-tests/pom.xml
COPY oop-backend/src ./oop-backend/src
COPY lib-repo ./lib-repo
RUN mvn -q -pl oop-backend -am -DskipTests package

FROM eclipse-temurin:17-jre
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl tzdata \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 iam \
 && mkdir -p /app/logs
COPY deploy/swarm/entrypoint.sh /app/entrypoint.sh
COPY --from=build /build/oop-backend/target/polyauth-oop-backend-1.0.0-SNAPSHOT.jar /app/app.jar
RUN sed -i 's/\r$//' /app/entrypoint.sh \
 && chmod 0755 /app/entrypoint.sh \
 && chown -R iam:iam /app
ENV LOG_PATH=/app/logs
USER 10001
EXPOSE 8080 8082
ENTRYPOINT ["/app/entrypoint.sh"]
