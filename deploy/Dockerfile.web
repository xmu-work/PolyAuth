# 前端镜像（构建上下文 = 仓库根目录 RBAC/）
#   docker build -f deploy/Dockerfile.web -t <registry>/iam-web:1.0.0 .
# 构建读取 web/.env.production：VITE_API_BASE=/api/v1，生产走同源 /api/v1。

FROM node:20-alpine AS build
WORKDIR /build
RUN npm install -g pnpm@9
COPY web/package.json web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY web/ ./
RUN pnpm build

FROM nginx:1.27-alpine
ENV API_UPSTREAM=http://app:8080
ENV NGINX_ENVSUBST_FILTER=^API_UPSTREAM$
COPY deploy/nginx-default.conf /etc/nginx/templates/default.conf.template
COPY --from=build /build/dist /usr/share/nginx/html
EXPOSE 80
